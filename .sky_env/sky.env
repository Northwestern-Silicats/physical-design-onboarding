# Cadence environment for Northwestern EECS -- Sky130 + FreePDK45
# Usage (tcsh):  source sky.env

# ---------------------------------------------------------------------------
# PDK paths
# ---------------------------------------------------------------------------
setenv FREEPDK_DIR /vol/eecs391/FreePDK45
setenv SKY130_DIR  /vol/eecs391/SKY130_PDK
setenv SKY130_RELEASE $SKY130_DIR/sky130_release_0.1.0
setenv SKY130_SCL     $SKY130_DIR/sky130_scl_9T_0.1.2

# PDK_DIR is kept pointing at FreePDK45 on purpose: ~/.cdsinit and ~/cds.lib
# build paths from $PDK_DIR/ncsu_basekit/..., which only exists in FreePDK45.
# Use $SKY130_DIR / $SKY130_RELEASE for anything Sky130-specific.
setenv PDK_DIR $FREEPDK_DIR

# ---------------------------------------------------------------------------
# Cadence licensing
# ---------------------------------------------------------------------------
setenv CDS_LIC_FILE 5280@cadencelm.eecs.northwestern.edu

# ---------------------------------------------------------------------------
# Virtuoso / custom IC (IC618)
# ---------------------------------------------------------------------------
setenv CDSHOME /vol/cadence2018/IC618
setenv OA_HOME $CDSHOME/oa_v22.60.031
setenv CDS_Netlisting_Mode Analog
setenv CDS_AUTO_64BIT ALL
setenv PATH ${PATH}:$CDSHOME/bin:$CDSHOME/tools/dfII/bin

# Spectre
setenv MMSIM_ROOT /vol/cadence2018/SPECTRE181
setenv PATH ${PATH}:$MMSIM_ROOT/bin:$MMSIM_ROOT/tools/spectre/bin

# ---------------------------------------------------------------------------
# Digital flow: synthesis, simulation, place & route
# ---------------------------------------------------------------------------
setenv PATH ${PATH}:/vol/cadence2018/GENUS181/bin
setenv PATH ${PATH}:/vol/cadence2018/XCELIUM1809/tools/bin
setenv PATH ${PATH}:/vol/cadence2018/INNOVUS162/bin

# ---------------------------------------------------------------------------
# Sky130 rule decks for DRC / LVS
# NOTE: sky130_release_0.1.0 is currently not readable by students
# (Permission denied), so the subfolder names below could not be verified.
# Check them with `ls $SKY130_RELEASE` once access is granted.
# ---------------------------------------------------------------------------
setenv SKY130_DRC $SKY130_RELEASE/Sky130_DRC
setenv SKY130_LVS $SKY130_RELEASE/Sky130_LVS

# ---------------------------------------------------------------------------
# Synopsys HSPICE / CosmosScope
# ---------------------------------------------------------------------------
setenv PATH ${PATH}:/vol/synopsys2012/hspice_vF-2011.09-SP1/hspice/bin
setenv PATH ${PATH}:/vol/synopsys2012/cosmosscope_vF-2011.09/ai_bin

# ---------------------------------------------------------------------------
# Ciranova PyCells (FreePDK45)
# ---------------------------------------------------------------------------
setenv PYTHONPATH $FREEPDK_DIR/ncsu_basekit/techfile/cni

# ---------------------------------------------------------------------------
# Mentor Calibre
# ---------------------------------------------------------------------------
setenv MGLS_LICENSE_FILE 1717@mentorlm.eecs.northwestern.edu
setenv MGC_HOME /vol/mentor/Calibre-2011.4_35/ixl_cal_2011.4_35.27/
